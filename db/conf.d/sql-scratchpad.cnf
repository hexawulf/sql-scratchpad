[mariadbd]
# conservative memory budget suitable for small hosts (512 MB container limit)
innodb_buffer_pool_size = 96M
innodb_log_file_size    = 32M
performance_schema      = OFF
max_connections         = 150
table_open_cache        = 400
tmp_table_size          = 16M
max_heap_table_size     = 16M
key_buffer_size         = 8M

# safety
local_infile            = 0
secure_file_priv        = /var/lib/mysql-files-disabled
skip-symbolic-links
skip_name_resolve       = ON
max_statement_time      = 10
max_recursive_iterations = 1000
max_allowed_packet      = 4M

# dialect: strict mode enabled by default (matches MySQL 8 behaviour)
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
character_set_server = utf8mb4
collation_server     = utf8mb4_unicode_ci
default_time_zone    = '+00:00'
