{
  "name": "sql-scratchpad",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --passWithNoTests --project integration",
    "test:e2e": "playwright test",
    "test:golden": "vitest run --passWithNoTests --project golden",
    "seeds:verify": "tsx scripts/verify-seeds.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.1"
  }
}
