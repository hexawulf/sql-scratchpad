# SQL Scratchpad app environment (copy to ./deploy/app.env with chmod 600; never commit)
# SQLSCRATCHPAD_ADMIN_PASSWORD must match db.env. Do NOT include MARIADB_ROOT_PASSWORD here.
SQLSCRATCHPAD_ADMIN_PASSWORD=replace-with-random-admin-password
DB_HOST=db
DB_PORT=3306
HOST=0.0.0.0
PORT=5050
TRUST_PROXY=
LOG_LEVEL=info
